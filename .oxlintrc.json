{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "preserve-caught-error": "allow"
  },
  "ignorePatterns": ["**/*.svelte"],
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "no-useless-empty-export": "allow"
      }
    }
  ]
}
