# KOMA Build Tool — environment configuration
# The tool reads these from the process environment. No .env file is loaded,
# so export them in your shell (or CI) before launching the build tool.

# VPS / update server (required for the deploy commands)
KOMA_VPS_HOST=
KOMA_VPS_USER=ubuntu
KOMA_VPS_PATH=/var/www/koma-updates
KOMA_VPS_SSH_KEY=

# Versioning
BUILD_VERSION=2.0.0-alpha.3
UPDATE_CHANNEL=beta

# Landing page source for deploy (default: <repo>/apps/landing)
# KOMA_LANDING_DIR=
