# ═══════════════════════════════════════════════════════════════════════════
# KŌMA Studio — Auth Server ・ Environment Example
# ═══════════════════════════════════════════════════════════════════════════
# Copy to `.env.development` (gitignored) and adjust for your setup:
#
#   cp auth-server/.env.example auth-server/.env.development
#
# Then run from repo root:
#   bun run auth-server:migrate    # apply DB migrations
#   bun run auth-server:dev        # start dev server on :3001
# ═══════════════════════════════════════════════════════════════════════════

# Auth server runtime
PORT=3001
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3001
# For production (Production): BETTER_AUTH_URL=https://auth.koma-studio.site
# ────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────
# Local:     DATABASE_URL=postgresql://user:password@localhost:5432/koma_auth
# Remote:    DATABASE_URL=postgresql://user:password@your-db-host:5432/koma_auth
#
# NOTE: The DB connect_timeout was raised from 3 s to 15 s (src/db/client.ts)
# to avoid Cloudflare 522 errors when connecting to a remote PostgreSQL host.
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/koma_auth

# Redis (optional — falls back to memory store when unavailable)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ALGORITHM=HS256
JWT_KEY_ID=active
JWT_SECRET=replace-with-secure-secret-at-least-32-chars
# For HS256 rotation fallback (comma-separated secrets)
JWT_PREVIOUS_SECRETS=
# For RS256:
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# JWT_PREVIOUS_PUBLIC_KEYS_JSON=["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"]
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEYS_JSON=[]

# Better Auth
BETTER_AUTH_SECRET=replace-with-secure-secret-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173
# Optional explicit parent domain for Better Auth cross-subdomain cookies.
CROSS_SUBDOMAIN_COOKIE_DOMAIN=

# Rate limiting / captcha
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=

# App URLs / desktop coupling
APP_BASE_URL=http://localhost:5173
DESKTOP_APP_URL=komastudio://
ENFORCE_DESKTOP_CLIENT=false
ENFORCE_DESKTOP_REGISTRATION=false
DEV_WEB_LOGIN_ALLOWED=true
DESKTOP_CLIENT_TOKEN_TTL_SECONDS=600
DESKTOP_CLIENT_TOKEN_REFRESH_SKEW_SECONDS=90
DESKTOP_TRAVEL_TOKEN_TTL_MINUTES=30
DESKTOP_TRAVEL_DEVICE_DURATION_DAYS=14
DISABLE_TRAVEL_TOKEN_ENFORCEMENT=true
# DESKTOP_BOOTSTRAP_SECRET=

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=KŌMA Studio <no-reply@example.com>
RESEND_REPLY_TO_EMAIL=

# Auto-migration (opt-in)
# Set to "true" to run pending Drizzle migrations on every server start.
# Default: false — run `bun run db:migrate` manually instead.
# AUTO_MIGRATE=false

# ────────────────────────────────────────────────────────────────────────────
# Optional cross-subdomain cookie parent domain (preferred over the legacy
# CROSS_SUBDOMAIN_COOKIE_DOMAIN alias; both are read by the same env).
# AUTH_COOKIE_DOMAIN=auth.koma-studio.site

# ────────────────────────────────────────────────────────────────────────────
# Update feed server
# UPDATE_SERVER_URL=https://api.koma-studio.site/updates
# UPDATE_MANIFEST_CACHE_TTL_MS=30000

# ────────────────────────────────────────────────────────────────────────────
# Community feed moderation (Discord webhook receives auto-flagged posts)
# FEED_MODERATION_DISCORD_WEBHOOK_URL=
# FEED_MAX_LINKS_PER_POST=4
# FEED_MAX_MEDIA_ITEMS=3
# FEED_AUTO_FLAG_SCORE_THRESHOLD=0.7

# Smoke test (scripts/smoke.mjs) — optional, all have safe defaults
# AUTH_SERVER_URL=http://localhost:3001
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
# SMOKE_DESKTOP_DEVICE_ID=
# SMOKE_DESKTOP_MAC_FINGERPRINT=
# ────────────────────────────────────────────────────────────────────────────
