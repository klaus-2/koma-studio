# ──────────────────────────────────────────────────────────
# KŌMA Studio — Production environment (CI / release build)
# ──────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in the secrets.
# NEVER commit the actual .env.production file.

# Frontend / Electron URLs
VITE_AUTH_API_URL=https://auth.koma-studio.site
VITE_LOCAL_API_URL=http://localhost:8001
# Set to true to run fully local: skips the auth-server, login/register screens,
# and all auth-backed features (feed, rankings, remote content catalog).
VITE_AUTH_DISABLED=false
VITE_ENV=production
VITE_DISABLE_DEVTOOL=1
