# =============================================================================
# KŌMA Studio (Electron shell) — example environment
# =============================================================================
# Copy to `.env.development` and adjust. `.env.development` is git-ignored;
# never commit real secrets.
#
#   cp .env.example .env.development
#
# KŌMA Studio is 100% free software. There are no plans, tiers, quotas or
# billing of any kind. Every variable below is either a local path, a
# self-hosted service URL, or an optional integration you control.
# -----------------------------------------------------------------------------

# --- [RUNTIME] Frontend / Electron URLs --------------------------------------
VITE_AUTH_API_URL=http://localhost:3001          # Auth server base URL
VITE_LOCAL_API_URL=http://127.0.0.1:8001         # Mini-backend sidecar URL
VITE_ENV=development                             # development | production
VITE_AUTH_DISABLED=false                         # true = run fully local, skip login/feed

# --- [RUNTIME] Project links -------------------------------------------------
VITE_PROJECT_BUG_URL=https://github.com/klaus-2/koma-studio/issues
VITE_PROJECT_DISCORD_URL=https://discord.gg/tzaV2efD4e
VITE_PROJECT_WEBSITE_URL=https://koma-studio.site
KOMA_STUDIO_URL=https://koma-studio.site                                  # Website (RPC/menu)
KOMA_STUDIO_DOWNLOAD_URL=https://github.com/klaus-2/koma-studio/releases  # Download page (RPC)

# --- [RUNTIME] Bug report (opt-in, user-triggered) ---------------------------
BUG_REPORT_DISCORD_WEBHOOK_URL=                  # empty = disabled
IMGUR_CLIENT_ID=                                 # empty = no screenshots

# --- [RUNTIME] Mini-backend (local Python sidecar, 127.0.0.1:8001) -----------
# The sidecar binds to 127.0.0.1:8001 (loopback only) and is supervised by the
# Electron main process. The pipeline cache keys below are read by the
# mini-backend; the cache file lives under the app data directory.
MINI_BACKEND_PIPELINE_CACHE_TTL_SECONDS=1800
MINI_BACKEND_PIPELINE_CACHE_MAX_ENTRIES=256
MINI_BACKEND_PIPELINE_CACHE_BBOX_TOLERANCE_PX=5
MINI_BACKEND_BATCH_DEFAULT_CONCURRENCY=1
MINI_BACKEND_BATCH_MAX_CONCURRENCY=4
MINI_BACKEND_BATCH_MAX_IMAGES=20
# MINI_BACKEND_PYTHON=                          # interpreter override (empty = auto)
# MINI_BACKEND_ARTIFACTS_URL=                   # sidecar artifact feed override
# MINI_BACKEND_ACCELERATION_PROFILE=cpu         # cpu | nvidia-cuda | nvidia-cuda-legacy | nvidia-tensorrt | amd-rocm | intel-openvino | apple-mps

# --- [RUNTIME] Optional certificate pinning (SHA-256, comma-separated) -------
# SPKI pins or leaf certificate fingerprints, no colons.
AUTH_API_CERT_PINS_SHA256=                       # empty = disabled
UPDATE_SERVER_CERT_PINS_SHA256=                  # empty = disabled

# --- [RUNTIME] Desktop auto-update (electron-updater) ------------------------
# Talks to GitHub releases directly, or to a generic server (what the project's
# release pipeline uses).
UPDATE_PROVIDER=github                           # github | generic
UPDATE_GITHUB_OWNER=klaus-2
UPDATE_GITHUB_REPO=koma-studio
UPDATE_ALLOW_PRERELEASE=false
UPDATE_AUTO_DOWNLOAD=false
UPDATE_AUTO_INSTALL_ON_QUIT=true
# UPDATE_SERVER_URL=                            # required when UPDATE_PROVIDER=generic
# UPDATE_CHANNEL=stable

# --- [RUNTIME] Desktop auth bootstrap / session ------------------------------
ENFORCE_DESKTOP_CLIENT=false
DESKTOP_CLIENT_TOKEN_TTL_SECONDS=600
DESKTOP_CLIENT_TOKEN_REFRESH_SKEW_SECONDS=90
# DESKTOP_BOOTSTRAP_SECRET=                     # HMAC secret (min 24 chars); must match auth server
# DESKTOP_TRAVEL_TOKEN=                         # one-time travel unlock token

# --- [RUNTIME] Optional locations / debug ------------------------------------
# KOMA_MODELS_ROOT=                             # weights root (empty = app data dir)
# KOMA_EXTERNAL_STORAGE_ROOT=                   # external storage root (dev python runtime)
# DISCORD_RPC_CLIENT_ID=                        # "playing" status; aliases: DISCORD_CLIENT_ID / VITE_DISCORD_CLIENT_ID
# ELECTRON_OPEN_DEVTOOLS=0
# ELECTRON_ENABLE_DEBUG_LOGS=0
# ELECTRON_DISABLE_GPU=0

# --- [BUILD] Sidecar (mini-backend) build scripts — scripts/*.mjs|py ---------
# Only read by maintainers building the sidecar; contributors can ignore.
# MINI_BACKEND_SOURCE_DIR=
# MINI_BACKEND_VENV_NAME=.venv-mini             # sidecar venv directory name
# MINI_BACKEND_BUILD_DIR=
# MINI_BACKEND_DIST_DIR=
# MINI_BACKEND_FORCE_REBUILD=0
# MINI_BACKEND_INCLUDE_TENSORRT=0
# MINI_BACKEND_ARTIFACT_PROFILES=
# MINI_BACKEND_SKIP_RUNTIME_ARTIFACTS=0
# MINI_BACKEND_ARTIFACTS_HARDENED=0
# MINI_BACKEND_HARDEN_SKIP_CYTHON=0
# MINI_BACKEND_HARDEN_SKIP_PYARMOR=0
# MINI_BACKEND_HARDENED_DIR=
# MINI_BACKEND_EXTERNAL_STORAGE_ROOT=
# MINI_BACKEND_HARDENED_STORAGE_DIR=
# MINI_BACKEND_DISABLE_EXTERNAL_STORAGE_JUNCTIONS=0
# KOMA_PYTHON=                                  # base interpreter for the sidecar venv (default: py / python3)

# --- [BUILD] Packaging / release scripts -------------------------------------
# CSC_LINK=                                     # signing cert path or identity (empty = unsigned)
# CSC_KEY_PASSWORD=
# ELECTRON_BUILDER_PLATFORM_ARGS=
# RELEASE_INCLUDE_ZIP=0
# RELEASE_KEEP_WIN_UNPACKED=0
# HARDEN_NODE_MAX_OLD_SPACE_SIZE=8192           # Node heap (MB) for the hardened build
# BYTENODE_JOBS=[]
# SKIP_CERT_PIN_REFRESH=0
# STRICT_CERT_PIN_REFRESH=0
# UPDATE_EXAMPLE_CERT_PINS=0
