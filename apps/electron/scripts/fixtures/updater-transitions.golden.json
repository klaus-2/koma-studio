{
  "scenarios": [
    {
      "name": "checking clears progress, error and downloadedAt",
      "initialVersion": "1.3.1",
      "channel": "stable",
      "preTransitions": [
        { "type": "progress", "progress": { "percent": 80, "transferred": 800, "total": 1000, "speed": 0 } },
        { "type": "error", "message": "boom" }
      ],
      "transition": { "type": "checking" },
      "expectedState": {
        "status": "checking",
        "currentVersion": "1.3.1",
        "newVersion": null,
        "mandatory": false,
        "blocking": false,
        "blockingReason": null,
        "releaseNotes": null,
        "channel": "stable",
        "provider": "github",
        "autoInstallOnQuit": true,
        "allowPrerelease": false,
        "progress": null,
        "checkedAt": null,
        "downloadedAt": null,
        "error": null
      }
    },
    {
      "name": "available sets availability and clears transient fields",
      "initialVersion": "1.3.1",
      "channel": "stable",
      "preTransitions": [
        { "type": "progress", "progress": { "percent": 80, "transferred": 800, "total": 1000, "speed": 0 } },
        { "type": "error", "message": "boom" }
      ],
      "transition": { "type": "available", "version": "1.4.0", "releaseNotes": "notes", "checkedAt": 500 },
      "expectedState": {
        "status": "available",
        "currentVersion": "1.3.1",
        "newVersion": "1.4.0",
        "mandatory": false,
        "blocking": false,
        "blockingReason": null,
        "releaseNotes": "notes",
        "channel": "stable",
        "provider": "github",
        "autoInstallOnQuit": true,
        "allowPrerelease": false,
        "progress": null,
        "checkedAt": 500,
        "downloadedAt": null,
        "error": null
      }
    },
