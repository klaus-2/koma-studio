# =============================================================================
# KŌMA Studio — auth server example environment
# =============================================================================
# The auth server is an OPTIONAL, SELF-HOSTED companion service. It is not
# part of this repository; it lives in its own project and you run your own
# instance. KŌMA Studio works in local mode without it — accounts only exist
# to sync settings and to power the community feed.
#
# Copy to the auth server's own `.env` (never commit it) and adjust.
#
# There is no billing here. KŌMA Studio is 100% free: no plans, no tiers,
# no quotas, no payment provider.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=postgresql://user:password@localhost:5432/koma_studio
REDIS_URL=redis://localhost:6379

# --- JWT ----------------------------------------------------------------------
# Tokens are issued with audience "koma-studio-backend"; the desktop app and
# the mini-backend both verify that audience.
JWT_ALGORITHM=HS256
JWT_KEY_ID=active
JWT_SECRET=replace-with-secure-secret
# HS256 rotation fallback (comma-separated previous secrets)
JWT_PREVIOUS_SECRETS=
# For RS256 instead:
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PREVIOUS_PUBLIC_KEYS_JSON=["-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"]
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEYS_JSON=[]

# --- Better Auth ---------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-secure-secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional explicit parent domain for cross-subdomain cookies (e.g. .example.com)
CROSS_SUBDOMAIN_COOKIE_DOMAIN=

# --- Rate limiting / captcha ---------------------------------------------------
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=

# --- App URLs / desktop coupling ------------------------------------------------
APP_BASE_URL=http://localhost:5173
DESKTOP_APP_URL=komastudio://
ENFORCE_DESKTOP_CLIENT=false
ENFORCE_DESKTOP_REGISTRATION=false
# Shared secret for the legacy desktop bootstrap flow (not required with the
# device registration flow). If you set it here, it MUST match
# DESKTOP_BOOTSTRAP_SECRET in the desktop app's .env — both sides derive the
# same HMAC. Use at least 24 random characters, e.g.:
#   openssl rand -base64 32
# DESKTOP_BOOTSTRAP_SECRET=
DESKTOP_CLIENT_TOKEN_TTL_SECONDS=600
DESKTOP_CLIENT_TOKEN_REFRESH_SKEW_SECONDS=90
DESKTOP_TRAVEL_TOKEN_TTL_MINUTES=30
DESKTOP_TRAVEL_DEVICE_DURATION_DAYS=14

# --- Email delivery (Resend) -----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=KŌMA Studio <no-reply@example.com>
RESEND_REPLY_TO_EMAIL=
