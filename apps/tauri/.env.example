# =============================================================================
# KŌMA Studio — example environment
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
#
#   cp .env.example .env
#
# KŌMA Studio is 100% free software. There are no plans, tiers, quotas or
# billing of any kind. Every variable below is either a local path, a
# self-hosted service URL, or an optional integration you control.
# -----------------------------------------------------------------------------

# --- [RUNTIME] Frontend / desktop URLs ---------------------------------------
VITE_AUTH_API_URL=http://localhost:3001          # Auth server (see .env.auth.example); optional — app runs local without it
VITE_LOCAL_API_URL=http://localhost:8001         # Local Python sidecar, started by the desktop app
VITE_ENV=development                             # development | production

# --- [RUNTIME] Project links -------------------------------------------------
# Also update EXTERNAL_ALLOWED_HOST_SUFFIXES when changing these hosts.
VITE_PROJECT_BUG_URL=https://github.com/klaus-2/koma-studio/issues
VITE_PROJECT_DISCORD_URL=https://discord.gg/tzaV2efD4e
VITE_PROJECT_WEBSITE_URL=https://koma-studio.site

# --- [RUNTIME] Storage roots -------------------------------------------------
KOMA_MODELS_ROOT=                                # weights root (empty = app data dir)
KOMA_EXTERNAL_STORAGE_ROOT=                      # external storage root (e.g. E:\koma-studio\storage)

# --- [RUNTIME] Mini-backend (local Python sidecar, 127.0.0.1:8001) -----------
# The sidecar binds to 127.0.0.1:8001 (loopback only) and is supervised by the
# Tauri shell. The pipeline cache keys below are read by the mini-backend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,tauri://localhost
MINI_BACKEND_PIPELINE_CACHE_TTL_SECONDS=1800
MINI_BACKEND_PIPELINE_CACHE_MAX_ENTRIES=256
MINI_BACKEND_PIPELINE_CACHE_BBOX_TOLERANCE_PX=5
MINI_BACKEND_BATCH_DEFAULT_CONCURRENCY=1
MINI_BACKEND_BATCH_MAX_CONCURRENCY=4
MINI_BACKEND_BATCH_MAX_IMAGES=20
# MINI_BACKEND_ACCELERATION_PROFILE=cpu         # cpu | nvidia-cuda | nvidia-cuda-legacy | nvidia-tensorrt | amd-rocm | intel-openvino | apple-mps
# MINI_BACKEND_PYTHON=                          # interpreter override (empty = auto)
# KOMA_MINI_BACKEND_EXE=                        # sidecar executable override
# KOMA_LOCAL_API_SESSION_SECRET=                # session secret passed through to the sidecar
# MINI_BACKEND_ARTIFACTS_URL=                   # sidecar artifact feed override
# VITE_MINI_BACKEND_ARTIFACTS_URL=

# --- [RUNTIME] Bug report (opt-in, user-triggered) ---------------------------
BUG_REPORT_DISCORD_WEBHOOK_URL=                  # empty = disabled
IMGUR_CLIENT_ID=                                 # empty = no screenshots

# --- [RUNTIME] Optional certificate pinning (SHA-256, comma-separated) -------
# SPKI pins or leaf certificate fingerprints, no colons.
AUTH_API_CERT_PINS_SHA256=                       # empty = disabled
UPDATE_SERVER_CERT_PINS_SHA256=                  # empty = disabled

# --- [RUNTIME] Desktop auto-update -------------------------------------------
# The Tauri updater reads a self-hosted manifest, NOT a GitHub release feed.
# (Electron uses UPDATE_GITHUB_*; Tauri uses the variable below.)
KOMA_UPDATE_MANIFEST_URL=https://api.koma-studio.site/updates/v2

# --- [RUNTIME] Desktop auth bootstrap / session ------------------------------
ENFORCE_DESKTOP_CLIENT=false
# DESKTOP_BOOTSTRAP_SECRET=                     # HMAC secret (min 24 chars); must match auth server
# DESKTOP_TRAVEL_TOKEN=                         # one-time travel unlock token

# --- [RUNTIME] Optional Discord Rich Presence --------------------------------
DISCORD_CLIENT_ID=                               # "playing" status; sends no data to the project
VITE_DISCORD_CLIENT_ID=

# --- [TEST] e2e / dev only (not read by the packaged app) --------------------
# TAURI_DEV_HOST=
# VITE_PORT=5176
# VITE_PLAYWRIGHT_WEB_ACCESS=
# PLAYWRIGHT_BASE_URL= PLAYWRIGHT_HOST= PLAYWRIGHT_PORT=
# PLAYWRIGHT_REUSE_SERVER= PLAYWRIGHT_V1_PORT= PLAYWRIGHT_V1_BASE_URL=
# PLAYWRIGHT_V1_COMMAND= PLAYWRIGHT_V2_BASE_URL=
# PLAYWRIGHT_VISUAL_COMPARE= PLAYWRIGHT_VISUAL_MAX_DIFF=
# KOMA_V1_ROOT=                                 # legacy v1 checkout for e2e/benchmarks

# --- [BUILD] Release build scripts (scripts/*.mjs) ---------------------------
# Only read by maintainers producing signed releases; contributors can ignore.
# KOMA_EMBED_MINI_BACKEND=0                     # 1 = embed the sidecar in the release
# KOMA_SKIP_MINI_BOOTSTRAP=0                    # 1 = skip the sidecar venv bootstrap
# KOMA_BUILD_PROFILE=                           # sidecar build profile (default: auto-detect)
# MINI_BACKEND_VENV_NAME=.venv-mini             # sidecar venv directory name
# HARDEN_NODE_MAX_OLD_SPACE_SIZE=8192           # Node heap (MB) for the hardened build
# TAURI_SIGNING_PRIVATE_KEY=                    # updater signing key (required for signed releases)
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# KOMA_WINDOWS_CERT_THUMBPRINT=
# WINDOWS_CERTIFICATE_THUMBPRINT=
# CSC_LINK=
# UPDATE_VERSION= UPDATE_CHANNEL= UPDATE_BASE_URL=    # manifest generation; CLI flags win
# UPDATE_SIGNING_PRIVATE_KEY_PEM= UPDATE_SIGNING_PRIVATE_KEY_PEM_PATH=
# KOMA_EMBEDDED_MINI_BACKEND=1                  # set automatically by release builds
