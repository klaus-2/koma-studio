{
  "name": "@koma/tauri",
  "version": "2.0.0-alpha.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.18"
  },
  "private": true,
  "description": "KŌMA Studio v2 — Tauri-based scanlation toolkit",
  "type": "module",
  "author": "KŌMA Studio",
  "license": "MIT",
  "homepage": "https://koma-studio.site/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaus-2/koma-studio.git"
  },
  "bugs": {
    "url": "https://github.com/klaus-2/koma-studio/issues"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:desktop": "bun run --parallel --no-exit-on-error --elide-lines=0 mini:ensure auth-server:dev dev",
    "dev:web": "bun run --parallel --no-exit-on-error auth-server:dev dev",
    "auth-server:setup": "node scripts/setup-auth-server.mjs",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1",
    "auth-server:dev": "bun run --filter @koma/auth-server dev",
    "auth-server:install": "bun install",
    "auth-server:migrate": "bun run --filter @koma/auth-server db:migrate",
    "auth-server:db:push": "bun run --filter @koma/auth-server db:push",
    "build": "tsc --noEmit && vite build --mode production",
    "build:react": "vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:headed": "vitest run --config vitest.browser.config.ts --browser.headless=false",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "qa:e2e-plan": "node scripts/verify-e2e-plan.mjs",
    "benchmark:phase1": "node scripts/benchmark-phase1-performance.mjs",
    "audit:lines": "node scripts/audit-line-counts.mjs",
    "audit:lines:update-baseline": "node scripts/audit-line-counts.mjs --update-baseline",
    "audit:deps": "depcruise interface src-tauri --config .dependency-cruiser.cjs",
    "mini:venv": "node scripts/mini-venv.mjs",
    "mini:install-deps": "node scripts/mini-venv.mjs --install",
    "mini:ensure": "node scripts/mini-venv.mjs --ensure",
    "mini:check": "node scripts/mini-venv.mjs --check",
    "harden:mini": "bun run mini:install-deps && node scripts/run-mini-python.mjs scripts/harden-mini-backend.py",
    "harden:frontend": "node scripts/harden-frontend.mjs",
    "build:hardened:win": "node scripts/build-hardened-release.mjs --platform win",
    "build:hardened:mac": "node scripts/build-hardened-release.mjs --platform mac",
    "build:hardened:linux": "node scripts/build-hardened-release.mjs --platform linux",
    "build:update-manifest": "node scripts/build-update-manifest.mjs"
  },
  "dependencies": {
    "@koma/auth": "workspace:*",
    "@koma/interface": "workspace:*",
    "@koma/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.33.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-gcolor-picker": "^1.3.5",
    "react-idle-timer": "^5.7.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koma/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.9.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^4.2.2",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
