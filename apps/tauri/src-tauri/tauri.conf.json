{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KŌMA Studio",
  "version": "1.2.0",
  "identifier": "com.komastudio.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KŌMA Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost app:; base-uri 'self'; object-src 'none'; script-src 'self' app:; frame-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' tauri://localhost app:; img-src 'self' data: blob: https: tauri://localhost app: http://koma-image.localhost https://koma-image.localhost; connect-src 'self' tauri://localhost app: ipc://localhost http://127.0.0.1:* ws://127.0.0.1:* https:; font-src 'self' data: http://koma-font.localhost https://koma-font.localhost; worker-src 'self' blob: app: https://challenges.cloudflare.com",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© KŌMA Studio",
    "category": "Productivity",
    "shortDescription": "Scanlation toolkit",
    "longDescription": "KŌMA Studio is a comprehensive scanlation toolkit for cleaning, translating and typesetting manga.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        "komastudio"
      ]
    }
  }
}
