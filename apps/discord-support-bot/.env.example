# Kluster AI
LLM_PROVIDER_KLUSTER_AI_ENABLED=false
LLM_PROVIDER_KLUSTER_AI_API_KEY=
LLM_PROVIDER_KLUSTER_AI_API_BASE=https://api.kluster.ai/v1
