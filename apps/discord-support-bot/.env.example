# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
# Optional: set to your test/community Guild ID for instant slash command registration
DISCORD_GUILD_ID=
# Comma-separated channel IDs where the bot proactively responds to support questions
SUPPORT_CHANNEL_IDS=
# Optional channel ID for moderation audit logs
MOD_LOG_CHANNEL_ID=
# Comma-separated Discord role IDs considered staff/moderators
STAFF_ROLE_IDS=

# Local AI / Embeddings API (OpenAI-compatible: Ollama /v1, LM Studio, llama.cpp, vLLM)
AI_API_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_CHAT_MODEL=qwen2.5-coder:14b
AI_EMBED_MODEL=nomic-embed-text
AI_TIMEOUT_SECS=120

# Repository RAG Indexing
# Relative or absolute path to the koma-studio repository root
REPO_ROOT=../..
RAG_DB_PATH=./data/koma-rag.sqlite
RAG_TOP_K=8
RAG_CHUNK_LINES=85
RAG_CHUNK_OVERLAP=15

# GitHub Integration (Bot Account PAT for Issues & Draft PRs with confirmation)
GITHUB_TOKEN=
GITHUB_OWNER=klaus-2
GITHUB_REPO=koma-studio
GITHUB_BASE_BRANCH=main

# Moderation Settings
MODERATION_ENABLED=true
MOD_FLOOD_MAX_MSGS=6
MOD_FLOOD_WINDOW_SECS=8
MOD_MAX_MENTIONS=5
MOD_BLOCK_INVITES=true

# Bot Custom Status & Support Threads
BOT_STATUS_TEXT=KŌMA Studio Support • /ask ou @menção|Dúvidas sobre o KŌMA? Me mencione!|AIO · Cleaner · Typesetter · Translator
BOT_STATUS_ROTATE_SECS=300
AUTO_THREADS_ENABLED=true
THREAD_MIN_QUESTION_CHARS=80
THREAD_MIN_ANSWER_CHARS=450
