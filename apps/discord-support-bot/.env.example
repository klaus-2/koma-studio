# Fireworks
LLM_PROVIDER_FIREWORKS_ENABLED=false
LLM_PROVIDER_FIREWORKS_API_KEY=
LLM_PROVIDER_FIREWORKS_API_BASE=https://api.fireworks.ai/inference/v1
LLM_PROVIDER_FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

