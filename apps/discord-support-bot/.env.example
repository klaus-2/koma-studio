# Discord
# Token from discord.com/developers/applications (Bot > Reset Token)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ALLOWED_CHANNEL_IDS=
ADMIN_ROLE_NAME=Admin

# Embeddings / indexing backend
# The bot uses OpenAI or Ollama for embeddings/indexing.
USE_OLLAMA=false
# Required when USE_OLLAMA=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODEL=llama3.1

# RAG
CODEBASE_PATH=../../
VECTOR_DB_PATH=./chroma_db
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5
INDEX_COLLECTION_NAME=koma_support_kb

# Response generation routing
# Failover order across the FREE/cloud providers cataloged in KŌMA.
LLM_PROVIDER_PRIORITY=openrouter,groq,huggingface_router,google_ai_studio,cloudflare_workers_ai,github_models
LLM_RATE_LIMIT_COOLDOWN_SECONDS=300

# Runtime
LOG_LEVEL=INFO

# ============================================================
# Configure at least 1 provider below for the bot's responses.
# The bot walks the order above and rotates automatically when
# a provider/model returns a rate-limit/quota/temporary error.
# ============================================================

# OpenRouter
LLM_PROVIDER_OPENROUTER_ENABLED=false
LLM_PROVIDER_OPENROUTER_API_KEY=
LLM_PROVIDER_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
LLM_PROVIDER_OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Groq
LLM_PROVIDER_GROQ_ENABLED=false
LLM_PROVIDER_GROQ_API_KEY=
LLM_PROVIDER_GROQ_API_BASE=https://api.groq.com/openai/v1
LLM_PROVIDER_GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Router
LLM_PROVIDER_HUGGINGFACE_ROUTER_ENABLED=false
LLM_PROVIDER_HUGGINGFACE_ROUTER_API_KEY=
LLM_PROVIDER_HUGGINGFACE_ROUTER_API_BASE=https://router.huggingface.co/v1
LLM_PROVIDER_HUGGINGFACE_ROUTER_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Cerebras
LLM_PROVIDER_CEREBRAS_ENABLED=false
LLM_PROVIDER_CEREBRAS_API_KEY=
LLM_PROVIDER_CEREBRAS_API_BASE=https://api.cerebras.ai/v1
LLM_PROVIDER_CEREBRAS_MODEL=llama-3.3-70b

# Google AI Studio (Gemini native)
LLM_PROVIDER_GOOGLE_AI_STUDIO_ENABLED=false
LLM_PROVIDER_GOOGLE_AI_STUDIO_API_KEY=
LLM_PROVIDER_GOOGLE_AI_STUDIO_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
LLM_PROVIDER_GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash

# NVIDIA NIM
LLM_PROVIDER_NVIDIA_NIM_ENABLED=false
LLM_PROVIDER_NVIDIA_NIM_API_KEY=
LLM_PROVIDER_NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_PROVIDER_NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Mistral La Plateforme
LLM_PROVIDER_MISTRAL_PLATEFORME_ENABLED=false
LLM_PROVIDER_MISTRAL_PLATEFORME_API_KEY=
LLM_PROVIDER_MISTRAL_PLATEFORME_API_BASE=https://api.mistral.ai/v1
LLM_PROVIDER_MISTRAL_PLATEFORME_MODEL=mistral-small-latest

# Mistral Codestral
LLM_PROVIDER_MISTRAL_CODESTRAL_ENABLED=false
LLM_PROVIDER_MISTRAL_CODESTRAL_API_KEY=
LLM_PROVIDER_MISTRAL_CODESTRAL_API_BASE=https://codestral.mistral.ai/v1
LLM_PROVIDER_MISTRAL_CODESTRAL_MODEL=codestral-latest

# Vercel AI Gateway
LLM_PROVIDER_VERCEL_AI_GATEWAY_ENABLED=false
LLM_PROVIDER_VERCEL_AI_GATEWAY_API_KEY=
LLM_PROVIDER_VERCEL_AI_GATEWAY_API_BASE=https://ai-gateway.vercel.sh/v1
LLM_PROVIDER_VERCEL_AI_GATEWAY_MODEL=openai/gpt-oss-20b

# Cohere
LLM_PROVIDER_COHERE_ENABLED=false
LLM_PROVIDER_COHERE_API_KEY=
LLM_PROVIDER_COHERE_API_BASE=https://api.cohere.ai/compatibility/v1
LLM_PROVIDER_COHERE_MODEL=command-a-03-2025

# GitHub Models
LLM_PROVIDER_GITHUB_MODELS_ENABLED=false
LLM_PROVIDER_GITHUB_MODELS_API_KEY=
LLM_PROVIDER_GITHUB_MODELS_API_BASE=https://models.inference.ai.azure.com
LLM_PROVIDER_GITHUB_MODELS_MODEL=gpt-4o-mini

# Cloudflare Workers AI
LLM_PROVIDER_CLOUDFLARE_WORKERS_AI_ENABLED=false
LLM_PROVIDER_CLOUDFLARE_WORKERS_AI_API_KEY=
LLM_PROVIDER_CLOUDFLARE_WORKERS_AI_API_BASE=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
LLM_PROVIDER_CLOUDFLARE_WORKERS_AI_MODEL=@cf/openai/gpt-oss-20b

# Zhipu AI
LLM_PROVIDER_ZHIPU_AI_ENABLED=false
LLM_PROVIDER_ZHIPU_AI_API_KEY=
LLM_PROVIDER_ZHIPU_AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_PROVIDER_ZHIPU_AI_MODEL=glm-4-flash

# LLM7.io
LLM_PROVIDER_LLM7_IO_ENABLED=false
LLM_PROVIDER_LLM7_IO_API_KEY=
LLM_PROVIDER_LLM7_IO_API_BASE=https://api.llm7.io/v1
