# Ollama Cloud (native Ollama API)
LLM_PROVIDER_OLLAMA_CLOUD_ENABLED=false
LLM_PROVIDER_OLLAMA_CLOUD_API_KEY=
LLM_PROVIDER_OLLAMA_CLOUD_API_BASE=https://ollama.com
LLM_PROVIDER_OLLAMA_CLOUD_MODEL=gpt-oss:120b

# Google Cloud Vertex AI (OpenAI-compatible endpoint; configure base explicitly)
LLM_PROVIDER_GOOGLE_CLOUD_VERTEX_AI_ENABLED=false
LLM_PROVIDER_GOOGLE_CLOUD_VERTEX_AI_API_KEY=
LLM_PROVIDER_GOOGLE_CLOUD_VERTEX_AI_API_BASE=https://aiplatform.googleapis.com/v1/projects/<project_id>/locations/<location>/endpoints/openapi
