# =============================================================================
# KŌMA Studio — mini-backend (Python sidecar) example environment
# =============================================================================
# The desktop shells already set most of these for you. This file documents the
# variables the sidecar reads directly, useful when running it standalone:
#
#   cd packages/mini-backend && uvicorn app:app --port 8001
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every cloud/BYOK key is optional: the matching provider stays disabled while
# its key is empty, and the pipeline falls back to the local models.
# -----------------------------------------------------------------------------

# --- Cloud LLM / OCR providers (bring your own key) ---------------------------
# MINI_BACKEND_OPENAI_API_KEY=
# MINI_BACKEND_OPENAI_API_BASE=
# MINI_BACKEND_OPENAI_OCR_MODEL=
# MINI_BACKEND_GEMINI_API_KEY=
# MINI_BACKEND_GEMINI_API_BASE=
# MINI_BACKEND_GEMINI_OCR_MODEL=
# MINI_BACKEND_GEMINI_IMAGE_CLEAN_MODEL=
# MINI_BACKEND_GROK_API_KEY=
# MINI_BACKEND_GROK_API_BASE=
# MINI_BACKEND_GROK_OCR_MODEL=
# MINI_BACKEND_ANTHROPIC_API_KEY=
# MINI_BACKEND_ANTHROPIC_API_URL=
# MINI_BACKEND_DEEPSEEK_API_KEY=
# MINI_BACKEND_DEEPSEEK_API_BASE=
# MINI_BACKEND_ZAI_API_KEY=
# MINI_BACKEND_ZAI_API_BASE=
# MINI_BACKEND_ZAI_OCR_MODEL=
# MINI_BACKEND_GOOGLE_CLOUD_VISION_API_KEY=
# MINI_BACKEND_GOOGLE_CLOUD_VISION_API_BASE=
# MINI_BACKEND_MICROSOFT_VISION_API_KEY=
# MINI_BACKEND_MICROSOFT_VISION_API_BASE=

# --- Machine translation services --------------------------------------------
# MINI_BACKEND_MS_TRANSLATOR_KEY=
# MINI_BACKEND_MS_TRANSLATOR_REGION=
# MINI_BACKEND_MS_TRANSLATOR_ENDPOINT=
# MINI_BACKEND_YANDEX_API_KEY=
# MINI_BACKEND_YANDEX_FOLDER_ID=
# MINI_BACKEND_YANDEX_ENDPOINT=
# MINI_BACKEND_DEEPL_API_KEY=
# MINI_BACKEND_DEEPL_ENDPOINT=
# MINI_BACKEND_CUSTOM_TRANSLATOR_URL=
# MINI_BACKEND_CUSTOM_TRANSLATOR_API_KEY=
# MINI_BACKEND_CUSTOM_TRANSLATOR_MODEL=
# MINI_BACKEND_CUSTOM_TRANSLATOR_TIMEOUT=

# --- Inference tuning ---------------------------------------------------------
# MINI_BACKEND_LLM_TEMPERATURE=
# MINI_BACKEND_DETECTION_MODEL=
# MINI_BACKEND_DETECTION_CONF=
# MINI_BACKEND_DETECTION_NMS=
# MINI_BACKEND_DETECTION_SIZE=
# MINI_BACKEND_FORCE_DEVICE=
# MINI_BACKEND_WARMUP_DETECTOR=
# MINI_BACKEND_EXPOSE_MEMORY_ENDPOINTS=

# --- Model sources / locations -------------------------------------------------
# Where AI model weights are cached. Defaults to the app data directory.
# KOMA_MODELS_ROOT=
# Allow the vendored pororo OCR code to download its own weights.
# KOMA_PORORO_ALLOW_DOWNLOAD=
# Optional reference images directory used by the pipeline.
# KOMA_REFERENCE_IMAGES_DIR=

# --- Server ---------------------------------------------------------------------
# CORS origins. The desktop shells set this automatically; only needed when
# running the sidecar standalone against a web frontend.
# ALLOWED_ORIGINS=
