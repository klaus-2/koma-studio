    "./runtime-adapter": "./src/runtime-adapter.ts"
  },
  "dependencies": {
    "@koma/types": "workspace:*",
    "@koma/ui": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19",
    "react": "^19.2.0",
    "react-idle-timer": "^5.7.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-idle-timer": ">=5"
  }
