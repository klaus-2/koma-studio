{
  "name": "@koma/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client de auth compartilhado KŌMA: AuthContext + adapter de runtime + hooks + query/http/passwordPolicy — consumido como fonte TS direta (sem build)",
  "exports": {
